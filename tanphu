    for id, record in pairs(inventory) do
        if type(id) ~= "string" or type(record) ~= "table" or type(record.Name) ~= "string"
            or (failed and (failed[id] or 0) >= 3) then continue end
        local slot = record.Equipped
        if equippedOnly and (type(slot) ~= "number" or slot < 1 or slot > 5) then continue end
        local levels = unitLevels(record.Name)
        if not levels or levels[1].Price > budget then continue end
        if legendaryOnly then
            local catalog = towerCatalog and rawget(towerCatalog, record.Name)
            if type(catalog) ~= "table" or catalog.Rarity ~= "Legendary" or levels[1].Price ~= 200 then continue end
        end
        local cost = 0
        for _, level in ipairs(levels) do cost += level.Price end
        local score = preferLate and strength(levels[#levels]) / math.sqrt(cost)
            or strength(levels[1]) / levels[1].Price
        if not best or score > best.score or (score == best.score and id < best.id) then
            best = {id = id, name = record.Name, levels = levels, score = score}
        end
    end
    return best
end

