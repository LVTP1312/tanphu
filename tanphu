            or unit.NotInSummon or record.Name == LARGE then continue end
        local group = groups[record.Name]
        if not group then
            group = {plain = {}, protected = false}
            groups[record.Name] = group
        end
        local plain = record.Equipped == nil or record.Equipped == 0
        for key in pairs(record) do
            if key ~= "Name" and key ~= "Equipped" then
                plain = false
                break
            end
        end
        if plain then
            table.insert(group.plain, id)
        else
            group.protected = true
        end
    end
    for _, group in pairs(groups) do
        table.sort(group.plain)
        for index = group.protected and 1 or 2, #group.plain do
            table.insert(surplus, group.plain[index])
        end
    end
    table.sort(surplus)
    return surplus
end

