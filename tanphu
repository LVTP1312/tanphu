local function unitLevels(name)
    if name == "Speakerman" then return STARTER end
    local unit = towerCatalog and rawget(towerCatalog, name)
    local levels = type(unit) == "table" and unit.Upgrades
    if type(levels) ~= "table" or #levels == 0 or #levels > 20 then return nil end
    if unit.Hill or unit.IsHill then return nil end
    for key, value in pairs(type(unit.Tags) == "table" and unit.Tags or {}) do
        if tostring(key):lower():find("hill", 1, true)
            or tostring(value):lower():find("hill", 1, true) then return nil end
    end
    for index = 1, #levels do
        local level = levels[index]
        if type(level) ~= "table" or not positive(level.Price) or not positive(level.Damage)
            or not positive(level.Cooldown) or not positive(level.Range) then return nil end
    end
    return levels
end

local function strength(level)
    return (level.Damage / level.Cooldown) * math.sqrt(level.Range)
end

