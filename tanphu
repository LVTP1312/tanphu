            advanceSummonGoal(coins)
            skippedSummon = slotName
            warn("[CTD] Summon checked: " .. details .. " | Next check at " .. tostring(summonGoal) .. " Coin")
            status.Text = ("0.01%%: %s | Not on list. Next check %d Coin."):format(slotName, summonGoal)
            roll, env.CTDToiletCitySummon = nil, nil
            return false
        end
        roll.before, roll.sentAt, roll.spending = coins, now, true
        skippedSummon = false
        summonSpending = true
        status.Text = SUMMON_BUILD .. " | Rolling x10 | " .. details
        warn(("[CTD] %s | Coins %d | Basic Crate x10 | %s"):format(SUMMON_BUILD, coins, details))
        local purchase = roll
        task.spawn(function()
            if not alive then return end
            local ok, result = pcall(function() return remote:InvokeServer("Basic Crate", 10) end)
            purchase.ok = ok and result ~= false
        end)
        return true
    end

    task.spawn(function()
        local storage = game:GetService("ReplicatedStorage")
        while alive do
            task.wait(1.5)
            if not alive or joining then continue end
            local profile = readProfile(false)
            local inventory = profile and profile.Towers
            if type(inventory) ~= "table" then
                status.Text = "Waiting for your unit inventory..."
                continue
            end
            local now = os.clock()
            if advanceSummon(storage, profile, now) then continue end
            if pendingEquip then
                local record = inventory[pendingEquip.id]
                if record and type(record.Equipped) == "number" and record.Equipped > 0 then
                    status.Text = "Equipped " .. pendingEquip.name
                    pendingEquip, nextEquip = nil, now + 4
                elseif now >= pendingEquip.deadline then
                    equipUnconfirmed = pendingEquip
                    status.Text = "Equip unconfirmed: " .. pendingEquip.name
                    pendingEquip, nextEquip = nil, now + 4
                end
                continue
            end
            if now < nextEquip then continue end
            local preferred = preferredUnit(inventory)
            if isEquipped(preferred, inventory) then
                joinMatch("Normal")
                continue
            end
            local unitId = preferred and preferred.id
            local unitName = preferred and preferred.name
            local equipped
            if not unitId then
                equipped = pickUnit(inventory, true, 200, false)
                local candidate = pickUnit(inventory, false, 200, false)
                if candidate and (not equipped or candidate.score > equipped.score * 1.05) then
                    unitId, unitName = candidate.id, candidate.name
                elseif equipped then
                    local bestLate = pickUnit(inventory, false, 1200, true)
                    local equippedLate = pickUnit(inventory, true, 1200, true)
                    if bestLate and equippedLate and bestLate.score > equippedLate.score * 1.05 then
                        unitId, unitName = bestLate.id, bestLate.name
                    end
                end
            end
            local equippedCount = 0
            for _, record in pairs(inventory) do
                if type(record) == "table" and type(record.Equipped) == "number" and record.Equipped > 0 then
                    equippedCount += 1
                end
            end
            local equipLimit = preferred and 5 or 4
            if not unitId or requested[unitId] or equippedCount >= equipLimit then
                if equipped then
                    joinMatch("Easy")
                elseif unitId and equippedCount >= equipLimit then
                    status.Text = "Free a slot to equip " .. unitName
                elseif equipUnconfirmed then
                    status.Text = "Check Equip for " .. equipUnconfirmed.name
                else
                    status.Text = "Waiting for your starter ground unit"
                end
                continue
            end
            local remote = find(storage, "ModuleLoader", "Shared", "Network", "RemoteEvent", "EquipPart")
            if not remote or not remote:IsA("RemoteEvent") then
                status.Text = "Waiting for Equip..."
                continue
            end
            requested[unitId] = true
            pendingEquip = {id = unitId, name = unitName, deadline = now + 10}
            status.Text = "Equipping " .. unitName .. "..."
            remote:FireServer(unitId)
        end
    end)

    joinMatch = function(mode)
        if joining or pendingEquip then return end
        local profile = readProfile(false)
        if not profile then
            status.Text = "Checking Coins before entering Story..."
            return
        end
        if advanceSummon(game:GetService("ReplicatedStorage"), profile, os.clock()) then return end
        local elevators = workspace:FindFirstChild("Elevators")
        local character = player.Character
        if not elevators or not character or not character:FindFirstChild("HumanoidRootPart") then
            status.Text = "Waiting for lobby and character"
            return
        end
        local target, bestTime = nil, 0
        for _, elevator in ipairs(elevators:GetChildren()) do
            local base = elevator:FindFirstChild("BasePart")
            local map = find(base, "StatusGui", "MapName")
            local count = find(base, "StatusGui", "PlayersCount")
            local countdown = find(base, "StatusGui", "CountdownTime")
            local seconds = countdown and tonumber(countdown.Text) or 0
            if map and map.Text == "Toilet City" and count and count.Text == "0/5"
                and seconds > bestTime then
                target, bestTime = base, seconds
            end
        end
        if target then
            local queued = queueSource(('retries=0,mode=%q'):format(mode))
            if not queued then
                status.Text = "Waiting for Delta teleport queue..."
                return
            end
            joining = true
            task.delay(45, function() joining = false end)
            character:PivotTo(target.CFrame + Vector3.new(0, target.Size.Y / 2 + 3, 0))
            local profile = readProfile(false)
            local coins = profile and profile.Money
            local balance = type(coins) == "number" and coins >= 0 and coins < summonGoal
                and ("%d/%d Coin | "):format(math.floor(coins), summonGoal) or ""
            local reason = skippedSummon and ("0.01% " .. skippedSummon .. " not on list | ") or ""
            status.Text = reason .. balance .. "Joining Toilet City " .. mode .. "..."
        else
            status.Text = "No empty Toilet City elevator"
        end
    end
    bind(action.Activated, function()
        local profile = readProfile(false)
        local inventory = profile and profile.Towers
        if type(inventory) ~= "table" then return end
        local preferred = preferredUnit(inventory)
        if isEquipped(preferred, inventory) then
            joinMatch("Normal")
        elseif not preferred and pickUnit(inventory, true, 200, false) then
            joinMatch("Easy")
        end
    end)
    return
end

local function setup()
    local storage = game:GetService("ReplicatedStorage")
    local network, addRemote, upgradeRemote, skipRemote, replayRemote, voteRemote
    local loadDeadline = os.clock() + 30
    repeat
        network = find(storage, "ModuleLoader", "Shared", "Network", "RemoteEvent")
        addRemote = find(network, "TowerAdd")
        upgradeRemote = find(network, "TowerUpgrade")
        skipRemote = find(network, "WaveSkip")
        replayRemote = find(network, "PlayAgain")
        voteRemote = find(network, "ModeVote")
        if (addRemote and upgradeRemote and skipRemote and replayRemote and voteRemote) or not alive then break end
        task.wait(0.25)
    until os.clock() >= loadDeadline
    if not alive then return end
    if not addRemote or not addRemote:IsA("RemoteEvent")
        or not upgradeRemote or not upgradeRemote:IsA("RemoteEvent") then
        status.Text = "Tower remotes are still loading. Run again once the HUD appears."
        return
    end

    local map = workspace:WaitForChild("Game", 10)
    local towerFolder = map and map:WaitForChild("Towers", 10)
    local waypoints = map and map:WaitForChild("Waypoints", 10)
    local area = map and map:WaitForChild("TowerArea", 10)
    if not towerFolder or not waypoints or not area then
        status.Text = "Waiting for the Toilet City map. Run again after loading."
        return
    end

    local towerLimit = 15
    local tried = {}
    if env.CTDToiletCityOwnedJob ~= game.JobId then
        env.CTDToiletCityOwnedJob, env.CTDToiletCityOwnedIds = game.JobId, {}
        env.CTDToiletCityOwnedLevels = {}
        env.CTDToiletCityTVTarget = {}
    end
    local ownedIds = env.CTDToiletCityOwnedIds
    local confirmedLevels = env.CTDToiletCityOwnedLevels or {}
    env.CTDToiletCityOwnedLevels = confirmedLevels
    local tvTargets = env.CTDToiletCityTVTarget or {}
    env.CTDToiletCityTVTarget = tvTargets
    local calibration, pending
    local armed = true
    local nextAction = 0
    local failedPlacements = {}
    local retries = resume and resume.retries or 0
    local lastWave, waveStarted, skippedWave = nil, 0, nil
    local skipNotice
    local autoSkipAttempts, nextAutoSkipAttempt = 0, 0
    local nextSpeedAttempt = 0
    local preferredMode = resume and WAVE_LIMITS[resume.mode] and resume.mode
    local votedMode
    local waveLimit = WAVE_LIMITS[preferredMode] or WAVE_LIMITS.Easy
    local resultAt
    local previousCoins, coinsStableAt

    local function liveSolo()
        return alive and #Players:GetPlayers() == 1
    end

    local function flat(position)
        return Vector2.new(position.X, position.Z)
    end

    local function isLocalOwner(owner)
        return owner == player or tonumber(tostring(owner)) == player.UserId
    end

    local nextLevelScan = 0
    local function syncOwnedLevels(towers, byId)
        if type(getgc) ~= "function" or #towers == 0 or os.clock() < nextLevelScan then return end
        nextLevelScan = os.clock() + 8
        local ok, objects = pcall(getgc, true)
        if not ok or type(objects) ~= "table" then return end
        for _, object in ipairs(objects) do
            if type(object) ~= "table" then continue end
            local id = rawget(object, "Id")
            local tower = type(id) == "string" and byId[id]
            if not tower or type(rawget(object, "Stats")) ~= "table" then continue end
            local knownUnitId = rawget(object, "UnitId")
            local level = rawget(object, "Level")
            if type(knownUnitId) ~= "string" or type(level) ~= "number"
                or level < 1 or level > #tower.levels then
                continue
            end
            tower.level = math.max(tower.level, level)
            confirmedLevels[id] = tower.level
        end
    end

    local function readTowers(onlyName)
        local towers, byId, occupied = {}, {}, {}
        for _, model in ipairs(towerFolder:GetChildren()) do
            if not model:IsA("Model") then continue end
            local original = model:GetAttribute("OriginalPos")
            local position = typeof(original) == "CFrame" and original.Position or model:GetPivot().Position
            table.insert(occupied, flat(position))
            local name = find(model, "TroopStatus", "TroopName")
            local label = find(model, "TroopStatus", "TroopLevel")
            local ownerId = model:GetAttribute("OwnerUserId")
            local owned = ownerId == nil and ownedIds[model.Name] or isLocalOwner(ownerId)
            local levels = owned and name and (not onlyName or name.Text == onlyName) and unitLevels(name.Text)
            if levels and label then
                local level = tonumber(label.Text:match("Level%s+(%d+)"))
                if level and level >= 1 and level <= #levels then
                    local tower = {
                        id = model.Name,
                        name = name.Text,
                        pos = position,
                        level = math.max(level, confirmedLevels[model.Name] or 0),
                        levels = levels,
                    }
                    table.insert(towers, tower)
                    byId[tower.id] = tower
                end
            end
        end
        return towers, byId, occupied
    end

    local function buildPositions()
        local ordered = {}
        for _, part in ipairs(waypoints:GetChildren()) do
            if part:IsA("BasePart") and tonumber(part.Name) then
                table.insert(ordered, part)
            end
        end
        table.sort(ordered, function(a, b) return tonumber(a.Name) < tonumber(b.Name) end)
        if #ordered ~= 12 then return nil end
        local ninth = waypoints:FindFirstChild("9")
        if not ninth or not ninth:IsA("BasePart")
            or (flat(ninth.Position) - Vector2.new(39.91, 463.41)).Magnitude > 1 then return nil end

        local base = map:FindFirstChild("Base")
        if not base or not base:IsA("BasePart") then return nil end
        local basePoint = flat(base.Position)
        if (flat(ordered[1].Position) - basePoint).Magnitude < (flat(ordered[#ordered].Position) - basePoint).Magnitude then
            for index = 1, math.floor(#ordered / 2) do
                local other = #ordered + 1 - index
                ordered[index], ordered[other] = ordered[other], ordered[index]
            end
        end

        local segments, samples, positions = {}, {}, {}
        local routeLength = 0
        for index = 2, #ordered do
            local start = flat(ordered[index - 1].Position)
            local finish = flat(ordered[index].Position)
            local offset = finish - start
            if offset.Magnitude < 1 then continue end
            table.insert(segments, {start = start, offset = offset, distance = routeLength})
            local steps = math.ceil(offset.Magnitude / 2)
            for step = 0, steps - 1 do
                local fraction = (step + 0.5) / steps
                table.insert(samples, {
                    point = start + offset * fraction, distance = routeLength + offset.Magnitude * fraction,
                })
            end
            routeLength += offset.Magnitude
        end
        if routeLength == 0 then return nil end

        local function coverage(pos, radius)
            local score = 0
            for _, sample in ipairs(samples) do
                if (sample.point - pos).Magnitude <= radius then score += 1 end
            end
            return score
        end

        local function add(pos, elevation)
            local key = ("%d:%d"):format(math.round(pos.X * 2), math.round(pos.Y * 2))
            if positions[key] then return end
            local closest, progress = math.huge, 0
            for _, segment in ipairs(segments) do
                local offset = segment.offset
                local relative = pos - segment.start
                local fraction = math.clamp(relative:Dot(offset) / offset:Dot(offset), 0, 1)
                local distance = (relative - offset * fraction).Magnitude
                if distance < closest then
                    closest = distance
                    progress = (segment.distance + offset.Magnitude * fraction) / routeLength
                end
            end
            positions[key] = {
                pos = Vector3.new(pos.X, elevation, pos.Y),
                progress = progress,
                early = coverage(pos, 6),
                late = coverage(pos, 10),
            }
        end

        -- Positions accepted by the game during the Delta tests.
        add(Vector2.new(33.520317, 466.629791), -47.468552)
        add(Vector2.new(21.359303, 460.944489), -47.469936)
        add(Vector2.new(38.115803, 466.261902), -47.469975)
        add(Vector2.new(36.617115, 456.790924), -47.469982)

        local ground = RaycastParams.new()
        ground.FilterType = Enum.RaycastFilterType.Include
        ground.FilterDescendantsInstances = {area}
        for _, segment in ipairs(segments) do
            local direction = segment.offset.Unit
            local normal = Vector2.new(-direction.Y, direction.X)
            for step = 2.5, segment.offset.Magnitude - 2, 3.5 do
                for _, side in ipairs({-3.8, 3.8, -5.4, 5.4}) do
                    local candidate = segment.start + direction * step + normal * side
                    local clear = true
                    for _, lane in ipairs(segments) do
                        local relative = candidate - lane.start
                        local t = math.clamp(relative:Dot(lane.offset) / lane.offset:Dot(lane.offset), 0, 1)
                        if (relative - lane.offset * t).Magnitude < 3.2 then
                            clear = false
                            break
                        end
                    end
                    if clear then
                        local hit = workspace:Raycast(Vector3.new(candidate.X, -32, candidate.Y),
                            Vector3.new(0, -30, 0), ground)
                        if hit and hit.Normal.Y > 0.90 then add(candidate, hit.Position.Y + 1.8) end
                    end
                end
            end
        end
        return positions, coverage
    end

    local positions, coverage
    local mapDeadline = os.clock() + 15
    repeat
        if not alive then return end
        positions, coverage = buildPositions()
        if positions then break end
        task.wait(0.3)
    until os.clock() >= mapDeadline
    if not positions then
        status.Text = "Toilet City lane is unavailable. Run again after loading the map."
        return
    end
    local function readMatch()
        local gameUI = gui:FindFirstChild("GameUI")
        if not gameUI then return {} end
        local state = {}
        for _, object in ipairs(gameUI:GetDescendants()) do
            if (object:IsA("TextLabel") or object:IsA("TextButton")) and visible(object, gui) then
                local label = object.Text:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
                if label == "You Lost!" or label == "You Lost" then
                    state.result = state.result or "loss"
                elseif label == "You Won!" or label == "You Win!" or label == "Victory!"
                    or label == "You Won" or label == "You Win" then
                    state.result = "win"
                elseif label:match("^Voting") then
                    state.voting = true
                elseif label:match("^Play Again Starts In") then
                    state.replayPending = true
                elseif label:match("^Skip Wave%s*%(0/1%)$") then
                    state.canSkip = true
                end
                state.wave = state.wave or tonumber(label:match("^Wave%s+(%d+)$"))
                state.progress = state.progress or tonumber(label:match("^(%d+)%%%s+Complete$"))
                state.toilets = state.toilets or tonumber(label:match("^Toilets:%s*(%d+)$"))
                state.mode = state.mode or label:match("^Mode:%s*(.+)$")
            end
        end
        local money = find(gameUI, "Stats", "OtherUI", "Money", "Title")
        if money and visible(money, gui) then
            state.cash = tonumber((money.Text:gsub("[,$%s]", "")))
        end
        return state
    end

    local function readAccountCoins(force)
        local data = readProfile(force)
        if not data then return nil end
        local money = rawget(data, "Money")
        if type(money) == "number" and money >= 0 and money < math.huge and money % 1 == 0 then
            return money
        end
        return nil
    end

    local function queueReplay(nextRetries)
        local profile = readProfile(false)
        local inventory = profile and profile.Towers
        local mode = preferredMode or "Easy"
        if type(inventory) == "table" then
            mode = isEquipped(preferredUnit(inventory), inventory) and "Normal" or "Easy"
        end
        return queueSource(('retries=%d,mode=%q'):format(nextRetries, mode))
    end

    local function ensureDoubleSpeed(profile)
        local wins = profile and profile.Wins
        if type(wins) ~= "number" or wins < 200 or wins >= math.huge or wins ~= wins then return end
        local speed = workspace:GetAttribute("GameSpeed")
        if type(speed) == "number" and speed >= 2 then return end
        if os.clock() < nextSpeedAttempt then return end
        local button = find(gui, "GameUI", "GameSpeeds", "2", "TroopFrame", "InteractiveButton")
        if not button or not button:IsA("GuiButton") or not visible(button, gui)
            or type(firesignal) ~= "function" then return end
        nextSpeedAttempt = os.clock() + 10
        pcall(firesignal, button.Activated)
    end

    local function autoSkipState(button)
        local off, on = find(button, "UI1"), find(button, "UI2")
        if off and off:IsA("GuiObject") and on and on:IsA("GuiObject") then
            if off.Visible ~= on.Visible then return on.Visible end
            return nil
        end
        local color = button.BackgroundColor3
        if color.G > 0.5 and color.G - color.R > 0.3 then return true end
        if color.R > 0.5 and color.R - color.G > 0.3 then return false end
        return nil
    end

    local function ensureAutoSkip()
        local button = find(gui, "GameUI", "Stats", "AutoSkip", "Button")
        if not button or not button:IsA("GuiButton") or not visible(button, gui) then return false end
        local enabled = autoSkipState(button)
        if enabled == true then
            autoSkipAttempts = 0
            return true
        end
        if enabled == false and autoSkipAttempts < 6
            and os.clock() >= nextAutoSkipAttempt and type(firesignal) == "function" then
            autoSkipAttempts += 1
            nextAutoSkipAttempt = os.clock() + 3
            pcall(firesignal, button.Activated)
        end
        return autoSkipState(button) == true
    end

    local function safeToSkip(state)
        local enemies = map:FindFirstChild("Enemies")
        if not state.canSkip or not state.progress or state.progress < 50
            or state.wave >= waveLimit or skippedWave == state.wave
            or not skipRemote or not skipRemote:IsA("RemoteEvent") or not enemies then return false end
        for _, enemy in ipairs(enemies:GetChildren()) do
            if enemy:IsA("Model") and enemy.Name:lower():find("boss", 1, true) then
                return false
            end
        end
        return true
    end

    local function queueTVTarget(id, name)
        if name == TV_MAN and tvTargets[id] == nil then
            tvTargets[id] = "pending"
        end
    end

    local function applyTVTargets(byId)
        local remote = find(network, "TowerTarget")
        if not remote or not remote:IsA("RemoteEvent") then return end
        for id, tower in pairs(byId) do
            if tower.name == TV_MAN and tvTargets[id] == "pending" then
                -- Newly placed TV Men start on First. This remote cycles the target.
                tvTargets[id] = "sent"
                pcall(function() remote:FireServer({Id = id}) end)
            end
        end
    end

    bind(addRemote.OnClientEvent, function(data)
        if not armed or not liveSolo() or type(data) ~= "table" or type(data.Id) ~= "string"
            or type(data.UnitId) ~= "string" then return end
        local position = data.HomePos
        if typeof(position) ~= "Vector3" then
            if typeof(data.CFrame) ~= "CFrame" then return end
            position = data.CFrame.Position
        end
        for _, expected in ipairs({calibration or false, pending or false}) do
            if expected and expected.kind == "add" and expected.unitId == data.UnitId
                and os.clock() <= expected.deadline and (expected.pos - position).Magnitude <= 1.25 then
                if data.OwnerUserId ~= nil and not isLocalOwner(data.OwnerUserId) then return end
                ownedIds[data.Id] = true
                queueTVTarget(data.Id, expected.name)
                if expected == calibration then
                    calibration = nil
                else
                    pending = nil
                end
                failedPlacements[data.UnitId] = nil
                nextAction = os.clock() + 1
                break
            end
        end
    end)

    bind(upgradeRemote.OnClientEvent, function(data)
        if type(data) ~= "table" or type(data.Id) ~= "string" then return end
        local level = tonumber(data.Level)
        if level and level >= 1 and level <= 20 then
            confirmedLevels[data.Id] = math.max(level, confirmedLevels[data.Id] or 0)
        end
        if pending and pending.kind == "upgrade" and data.Id == pending.id
            and level == pending.level then
            pending = nil
            nextAction = os.clock() + 2.2
        end
    end)
    local hookOK, hookError = pcall(function()
        local previous
        previous = hookmetamethod(game, "__namecall", newcclosure(function(remote, ...)
            if alive and armed and (type(checkcaller) ~= "function" or not checkcaller())
                and remote == addRemote
                and getnamecallmethod() == "FireServer" then
                local data = ...
                if type(data) == "table" and type(data.Name) == "string" and unitLevels(data.Name)
                    and type(data.UnitId) == "string" and typeof(data.Pos) == "Vector3" then
                    calibration = {
                        kind = "add", pos = data.Pos, unitId = data.UnitId, name = data.Name,
                        deadline = os.clock() + 8,
                    }
                end
            end
            return previous(remote, ...)
        end))
    end)
    if not hookOK then
        status.Text = "Delta could not listen for tower placement"
        warn("[CTD]", hookError)
        return
    end

    action.Text = "Auto Story"
    status.Text = "Waiting for the mode vote..."

    local function leakedEnemy()
        local base = map:FindFirstChild("Base")
        local enemies = map:FindFirstChild("Enemies")
        if not base or not base:IsA("BasePart") or not enemies then return nil end
        local point, distance = nil, 24
        for _, enemy in ipairs(enemies:GetChildren()) do
            if not enemy:IsA("Model") then continue end
            local position = flat(enemy:GetPivot().Position)
            local remaining = (position - flat(base.Position)).Magnitude
            if remaining < distance then point, distance = position, remaining end
        end
        return point
    end

    local function bestPosition(occupied, batch, leak)
        local best, bestKey, bestScore
        local target = ({0.20, 0.35, 0.50, 0.68, 0.84})[batch]
        if batch > 1 and leak then target = math.max(target, 0.76) end
        for key, candidate in pairs(positions) do
            if tried[key] then continue end
            local point = flat(candidate.pos)
            local nearest = math.huge
            for _, other in ipairs(occupied) do
                nearest = math.min(nearest, (point - other).Magnitude)
            end
            if nearest >= 3.5 then
                local score = 2 * candidate.early + candidate.late + math.min(nearest, 12) / 4
                score -= math.abs(candidate.progress - target) * (batch == 1 and 125 or 75)
                if batch > 1 and leak then score += math.max(0, 18 - (point - leak).Magnitude) end
                if not bestScore or score > bestScore or (score == bestScore and key < bestKey) then
                    best, bestKey, bestScore = candidate.pos, key, score
                end
            end
        end
        return best, bestKey
    end

    local function place(position, key, unit)
        tried[key] = true
        pending = {kind = "add", pos = position, unitId = unit.id, name = unit.name, deadline = os.clock() + 5}
        addRemote:FireServer({
            Pos = position, CFrame = CFrame.new(position), Name = unit.name, UnitId = unit.id,
        })
    end

    local failedUpgrades = {}
    local function upgrade(tower, cash)
        pending = {
            kind = "upgrade", id = tower.id, level = tower.level + 1,
            cash = cash, deadline = os.clock() + 7,
        }
        upgradeRemote:FireServer({Id = tower.id})
    end

    while alive do
        task.wait(0.65)
        if not alive then break end
        local state = readMatch()
        if state.result then
            if not armed or not liveSolo() then continue end
            if state.mode and not WAVE_LIMITS[state.mode] then
                status.Text = "Replay paused for unsupported mode " .. state.mode
                break
            end
            local now = os.clock()
            if not resultAt then
                resultAt = now
                nextProfileScan = 0
            end
            local coins = readAccountCoins(true)
            if coins ~= nil then
                if coins ~= previousCoins then
                    previousCoins, coinsStableAt = coins, now
                elseif now - coinsStableAt >= 2.5 and now - resultAt >= 4 then
                    local profile = readProfile(false)
                    local inventory = profile and profile.Towers
                    local desired = type(inventory) == "table" and preferredUnit(inventory)
                    local needsEquip = desired and not isEquipped(desired, inventory)
                    if coins >= summonGoal or needsEquip then
                        local lobbyButton = find(gui, "GameUI", "FinalUI", "Content", "Lobby")
                        if not lobbyButton or not lobbyButton:IsA("GuiButton") or not visible(lobbyButton, gui) then
                            status.Text = ("%d/%d Coins | Waiting for Lobby button."):format(coins, summonGoal)
                            continue
                        end
                        if not queueSource('retries=0') then
                            status.Text = "Waiting for Delta teleport queue..."
                            continue
                        end
                        local activated = type(firesignal) == "function"
                            and pcall(firesignal, lobbyButton.Activated)
                        armed = false
                        action.Text = needsEquip and "Updating loadout" or "Goal reached"
                        status.Text = ("%d/%d Coins | %s"):format(coins, summonGoal,
                            activated and "Returning to lobby..." or "Press Lobby.")
                        if activated then
                            task.delay(15, function()
                                if alive then
                                    status.Text = ("%d/%d Coins | Press Lobby if still here."):format(coins, summonGoal)
                                end
                            end)
                        end
                        break
                    end
                    if not replayRemote or not replayRemote:IsA("RemoteEvent") then
                        status.Text = "Play Again is unavailable in this client."
                        break
                    end
                    if env.CTDToiletCityReplayJob == game.JobId then
                        status.Text = "Replay already requested for this match."
                        break
                    end
                    local queued = queueReplay(state.result == "loss" and retries + 1 or 0)
                    if not queued then
                        status.Text = "Waiting for Delta teleport queue..."
                        continue
                    end
                    env.CTDToiletCityReplayJob = game.JobId
                    status.Text = ("%d/%d Coins | Play Again"):format(coins, summonGoal)
                    if not state.replayPending then replayRemote:FireServer() end
                    break
                end
            end
            status.Text = "Checking your account Coins after the match..."
            if now - resultAt >= 20 and previousCoins == nil then
                status.Text = "Coin balance unavailable. Waiting on results."
            end
            continue
        end
        resultAt, previousCoins, coinsStableAt = nil, nil, nil
        if not armed or not liveSolo() then continue end
        local data = readProfile(false)
        local inventory = data and data.Towers
        local hasInventory = type(inventory) == "table"
        local preferred = hasInventory and preferredUnit(inventory)
        local equippedPreferred = hasInventory and isEquipped(preferred, inventory)
        action.Text = preferred and ("Only " .. preferred.name) or "Auto Story | Starter"
        if state.voting and not votedMode
            and voteRemote and voteRemote:IsA("RemoteEvent") then
            if equippedPreferred or (hasInventory and not preferred and pickUnit(inventory, true, 200, false)) then
                votedMode = equippedPreferred and "Normal" or "Easy"
                voteRemote:FireServer(votedMode)
                status.Text = "Voted " .. votedMode
            end
        end
        local mode = state.mode or votedMode or preferredMode or (equippedPreferred and "Normal" or "Easy")
        waveLimit = WAVE_LIMITS[mode] or WAVE_LIMITS.Easy
        local cash, wave = state.cash, state.wave
        if not cash or not wave or wave > waveLimit then continue end
        ensureDoubleSpeed(data)
        if wave ~= lastWave then
            lastWave, waveStarted = wave, os.clock()
            autoSkipAttempts = 0
            table.clear(failedPlacements)
        end
        local towers, byId, occupied = readTowers(preferred and preferred.name)
        applyTVTargets(byId)
        local readyToSkip = wave > 1 or #towers > 0
        if readyToSkip then
            local enabled = ensureAutoSkip()
            local elapsed = os.clock() - waveStarted
            if (elapsed >= 20 or (not enabled and autoSkipAttempts >= 6)) and safeToSkip(state) then
                skippedWave = wave
                skipNotice = {wave = wave, at = os.clock(), elapsed = math.floor(elapsed)}
                skipRemote:FireServer()
            end
        end
        if (not pending and cash >= 150)
            or (pending and pending.kind == "upgrade" and os.clock() >= pending.deadline) then
            syncOwnedLevels(towers, byId)
        end
        if pending then
            local completed = false
            if pending.kind == "upgrade" then
                local tower = byId[pending.id]
                completed = tower and tower.level >= pending.level
            else
                for _, tower in ipairs(towers) do
                    if tower.name == pending.name and (tower.pos - pending.pos).Magnitude <= 1.25 then
                        queueTVTarget(tower.id, tower.name)
                        completed = true
                        break
                    end
                end
            end
            if completed or os.clock() > pending.deadline then
                if not completed and pending.kind == "upgrade" then
                    local previous = failedUpgrades[pending.id]
                    local attempts = previous and previous.level == pending.level and previous.wave == wave
                        and previous.attempts or 0
                    -- Only retry when the tower did not level up and the HUD shows no debit.
                    local confirmedUnchanged = byId[pending.id] and cash >= pending.cash
                    failedUpgrades[pending.id] = {
                        level = pending.level,
                        wave = wave,
                        attempts = confirmedUnchanged and attempts + 1 or 3,
                        retryAt = os.clock() + 7,
                    }
                elseif pending.kind == "add" then
                    local id = pending.unitId
                    if completed then
                        failedPlacements[id] = nil
                    else
                        failedPlacements[id] = (failedPlacements[id] or 0) + 1
                    end
                end
                pending = nil
                nextAction = os.clock() + (completed and 2.2 or 1.5)
            end
            continue
        end
        if os.clock() < nextAction then continue end

        local upgradeTarget, bestValue, maxed, retrying = nil, nil, 0, false
        local leak = leakedEnemy()
        for _, tower in ipairs(towers) do
            local nextLevel = tower.levels[tower.level + 1]
            local cost = nextLevel and nextLevel.Price
            local failure = failedUpgrades[tower.id]
            local canTry = not failure or failure.level ~= tower.level + 1
                or (os.clock() >= failure.retryAt and (failure.wave ~= wave or failure.attempts < 3))
            if not cost then
                maxed += 1
            elseif cash >= cost and canTry then
                local value = coverage(flat(tower.pos), nextLevel.Range)
                    * (strength(nextLevel) - strength(tower.levels[tower.level])) / cost
                if leak then value += math.max(0, 14 - (flat(tower.pos) - leak).Magnitude) * 2 end
                if not bestValue or value > bestValue or (value == bestValue and tower.id < upgradeTarget.id) then
                    upgradeTarget, bestValue = tower, value
                end
            elseif cash >= cost then
                retrying = true
            end
        end
        local batch = math.min(5, math.floor(maxed / 3) + 1)
        local targetCount = math.min(towerLimit, batch * 3)
        local unit
        if preferred then
            if equippedPreferred and preferred.levels then unit = preferred end
        elseif hasInventory then
            unit = pickUnit(inventory, true, cash, batch > 1, failedPlacements)
        end
        local canPlace = unit and cash >= unit.levels[1].Price and (failedPlacements[unit.id] or 0) < 3
        local position, key
        local placementBatch = batch
        if canPlace and retrying and not upgradeTarget and cash >= unit.levels[1].Price + 300 then
            placementBatch = math.min(5, batch + 1)
        end
        if canPlace and #towers < math.max(targetCount, placementBatch * 3) and #occupied < towerLimit then
            position, key = bestPosition(occupied, placementBatch, leak)
        end
        local phase = position and ("Place B%d"):format(placementBatch) or ("Upgrade B%d"):format(batch)
        if unit and #towers == 0 and cash < unit.levels[1].Price then
            phase = ("Saving $%d for %s"):format(unit.levels[1].Price, unit.name)
        end
        if retrying and not position and not upgradeTarget then phase = "Upgrade retry" end
        if #occupied == towerLimit and maxed == towerLimit then phase = "All max" end
        local statusLine = ("%s W%d/%d | $%d | %d/15 units | %d max | %s"):format(
            mode, wave, waveLimit, cash, #towers, maxed, phase)
        if workspace:GetAttribute("GameSpeed") == 2 then statusLine ..= " | x2 Speed" end
        local coins = readAccountCoins(false)
        if coins ~= nil then statusLine = ("%d/%d Coin | "):format(coins, summonGoal) .. statusLine end
        if skipNotice and os.clock() - skipNotice.at < 8 then
            statusLine = ("Skip W%d at %ds | "):format(skipNotice.wave, skipNotice.elapsed) .. statusLine
        end
        status.Text = unit and statusLine or statusLine .. " | Waiting for an affordable unit."

        if position then
            place(position, key, unit)
        elseif not position and upgradeTarget then
            upgrade(upgradeTarget, cash)
        end
    end
end

